# Python feedback service (run separately from Next.js).
FEEDBACK_API_URL=http://localhost:8000
# For a hosted frontend, set this to the deployed Python service's HTTPS URL
# in Vercel Preview first. The browser calls Next.js, not Python directly.
# Set the same random key (32+ characters) on Next.js and Python when hosted.
# Never prefix the key with NEXT_PUBLIC_. Leave unset only for local development.
FORMCRAFT_API_KEY=
